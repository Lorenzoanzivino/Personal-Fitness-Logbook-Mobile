# =====================================================================
# PERSONAL FITNESS LOGBOOK - CONFIGURAZIONE AMBIENTE EXPO (.env)
# =====================================================================
# In Expo SDK 49+, le variabili con prefisso EXPO_PUBLIC_ sono automaticamente
# accessibili nel codice dell'app tramite process.env.EXPO_PUBLIC_*

# URL del Server Backend Fastify (Porta 8000):
# - Per test su Web o simulatore iOS: http://localhost:8000
# - Per emulatore Android (Android Studio): http://10.0.2.2:8000
# - Per smartphone fisico (Android / iPhone su Expo Go via Wi-Fi):
#   Sostituisci con l'IP LAN del tuo computer (es. http://192.168.1.150:8000)
EXPO_PUBLIC_API_URL=http://localhost:8000

# Ambiente applicativo
EXPO_PUBLIC_ENV=development

# Credenziali Master Trainer (Configurazione Iniziale / Seed)
EXPO_PUBLIC_TRAINER_USERNAME=Lorenzo
EXPO_PUBLIC_TRAINER_PASSWORD=admin123
EXPO_PUBLIC_TRAINER_FIRST_NAME=Lorenzo
EXPO_PUBLIC_TRAINER_LAST_NAME=Anzivino
EXPO_PUBLIC_TRAINER_EMAIL=lorenzo.anzivino@example.com
