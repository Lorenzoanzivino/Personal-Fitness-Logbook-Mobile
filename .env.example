# Personal Fitness Logbook - Mobile Environment Configuration Template
# Copy this file to .env and customize values for local development

# Centralized Backend API URL
EXPO_PUBLIC_API_URL=http://localhost:3001

# Application Environment
EXPO_PUBLIC_ENV=development

# Trainer Master Credentials (Demo / Placeholder)
EXPO_PUBLIC_TRAINER_USERNAME=trainer
EXPO_PUBLIC_TRAINER_PASSWORD=your_secure_password
EXPO_PUBLIC_TRAINER_FIRST_NAME=Trainer
EXPO_PUBLIC_TRAINER_LAST_NAME=Demo
EXPO_PUBLIC_TRAINER_EMAIL=trainer@example.com
