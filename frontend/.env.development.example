# =====================================================================
# PERSONAL FITNESS LOGBOOK - TEMPLATE SVILUPPO LOCALE (.env.development)
# =====================================================================
# Caricato automaticamente da Expo durante `npx expo start`
# URL Backend locale Fastify (Porta 8000):
# Sostituisci con l'IP LAN della tua macchina di sviluppo (es. http://192.168.1.150:8000 o http://172.28.53.239:8000)
EXPO_PUBLIC_API_URL=http://inserisci_ip_locale:8000

# Ambiente applicativo
EXPO_PUBLIC_ENV=development

# Credenziali Master Trainer
EXPO_PUBLIC_TRAINER_USERNAME=Lorenzo
EXPO_PUBLIC_TRAINER_PASSWORD=Admin123
EXPO_PUBLIC_TRAINER_FIRST_NAME=Lorenzo
EXPO_PUBLIC_TRAINER_LAST_NAME=Anzivino
EXPO_PUBLIC_TRAINER_EMAIL=lorenzo.anzivino@example.com
