{
  "expo": {
    "name": "MyTrainUp",
    "slug": "Personal-Fitness-Logbook-Mobile",
    "displayName": "MyTrainUp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo1.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.mytrainup.app",
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FF6B00"
      }
    },
    "web": {
      "favicon": "./assets/logo1.png"
    },
    "extra": {
      "eas": {
        "projectId": "47a6c279-42d8-41cc-91e9-65a41d28804d"
      }
    },
    "plugins": [
      "expo-audio",
      "expo-sharing"
    ],
    "splash": {
      "image": null,
      "backgroundColor": "#0F172A"
    }
  }
}