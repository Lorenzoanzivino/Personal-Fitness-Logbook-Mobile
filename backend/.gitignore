# Node.js Fastify Backend .gitignore
node_modules/
dist/
build/
*.tsbuildinfo

# Environment variables
.env
.env.*
*.env
*.env.*
*.bak
*.backup
!.env.example
!.env.*.example

# Secrets & Keys
*.key
*.pem
*.cert

# Logs & Database
*.log
npm-debug.*
yarn-debug.*
yarn-error.*
*.sqlite
*.db
uploads/*
!uploads/.gitkeep
