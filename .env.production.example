# =====================================================================
# VARIABILI D'AMBIENTE PER PRODUZIONE (VPS S ALMALINUX 9)
# Salvare come /opt/fitness-logbook/.env sul server
# =====================================================================

# ---------------------------------------------------------------------
# POSTGRESQL SETTINGS
# ---------------------------------------------------------------------
POSTGRES_DB=fitness_db
POSTGRES_USER=fitness_admin
# Sostituire con una password robusta di almeno 32 caratteri
POSTGRES_PASSWORD=generate_a_secure_postgres_password_here

# ---------------------------------------------------------------------
# BACKEND API & JWT SETTINGS
# ---------------------------------------------------------------------
# Sostituire con una chiave segreta di almeno 64 caratteri per firmare i JWT
JWT_SECRET=generate_a_super_secure_random_64_character_jwt_secret_key_here
PORT=8000

# ---------------------------------------------------------------------
# GITHUB CONTAINER REGISTRY (GHCR)
# ---------------------------------------------------------------------
# Sostituire con il tuo username GitHub o organizzazione
GHCR_REPO_OWNER=lorenzoanzivino
